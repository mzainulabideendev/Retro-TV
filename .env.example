# =====================================================================
# Retro TV — Environment Variables Example
# =====================================================================
# Copy this file to `.env` (never commit `.env`) or pass these values
# via --dart-define / --dart-define-from-file when building.
#
# Frontend-safe (publishable) values — OK to ship in the client bundle:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# SERVER-ONLY — never put these in client/browser code, never commit:
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres
